<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefWidth="300.0" spacing="15.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.infrastructure.ui.MetodosControllerAPI">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Novo Cartão/Conta" />

    <TextField fx:id="txtNomeMetodo" promptText="Nome (ex: Nubank)" />
    <TextField fx:id="txtVencimento" promptText="Dia do Vencimento" />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Cor:" />
        <ColorPicker fx:id="cpCor" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
    </HBox>

    <Button maxWidth="Infinity" onAction="#aoSalvar" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" text="Salvar" />

    <Button maxWidth="Infinity" onAction="#abrirListaMetodos" style="-fx-background-color: transparent; -fx-border-color: #3498db; -fx-text-fill: #3498db; -fx-border-radius: 3px; -fx-cursor: hand;" text="Ver Todos os Métodos" />

</VBox>