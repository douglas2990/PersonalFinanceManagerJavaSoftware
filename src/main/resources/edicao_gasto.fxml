<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane fx:controller="org.example.infrastructure.ui.EdicaoGastoControllerAPI"
          xmlns:fx="http://javafx.com/fxml" hgap="10" vgap="10" alignment="CENTER">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Descrição:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="txtDescricao" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <Label text="Valor (R$):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="txtValor" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Data:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <DatePicker fx:id="dpData" GridPane.rowIndex="2" GridPane.columnIndex="1" maxWidth="Infinity"/>

    <Label text="Categoria:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <ComboBox fx:id="cbCategoria" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="Infinity"/>

    <Label text="Método:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <ComboBox fx:id="cbMetodo" GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="Infinity"/>

    <Label text="Parcela Atual:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
    <TextField fx:id="txtParcelaAtual" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

    <Label text="Total Parcelas:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
    <TextField fx:id="txtTotalParcelas" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

    <Button text="Salvar Alterações" onAction="#salvarEdicao"
            GridPane.rowIndex="7" GridPane.columnIndex="0" GridPane.columnSpan="2"
            maxWidth="Infinity" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>

</GridPane>