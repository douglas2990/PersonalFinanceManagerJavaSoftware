<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.infrastructure.ui.MainController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Gerenciador de Finanças" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TextField fx:id="txtDescricao" promptText="Descrição do Gasto (ex: Nubank)"/>
    <TextField fx:id="txtValor" promptText="Valor (ex: 150.00)"/>

    <Button text="Salvar Gasto" onAction="#aoSalvar"/>
</VBox>
