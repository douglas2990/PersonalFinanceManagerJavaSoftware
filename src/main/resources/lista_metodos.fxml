<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="550.0" spacing="15.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.infrastructure.ui.ListaMetodosControllerAPI">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #2c3e50;" text="Gerenciar Métodos de Pagamento" />

    <TableView fx:id="tableMetodos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNome" prefWidth="200.0" text="Nome do Método" />
            <TableColumn fx:id="colVencimento" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Dia de Venc." />
            <TableColumn fx:id="colCor" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Cor (Hex)" />
            <TableColumn fx:id="colAcoes" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Ações" />
        </columns>
    </TableView>

    <Button maxWidth="Infinity" onAction="#voltar" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Voltar para Cadastro" />

</VBox>